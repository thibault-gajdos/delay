\contentsline {paragraph}{The condition effects sit before muscle activation, not after (R7--R10).}{7}{section*.13}%
\contentsline {paragraph}{The rate of partial activations falls (R22, R24, R25, R26).}{7}{section*.14}%
\contentsline {paragraph}{The closed forms do not apply here.}{7}{section*.15}%
