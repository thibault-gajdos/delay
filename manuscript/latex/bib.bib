@article{feltgenOvercompleteApproachFitting2021,
  title = {An {{Overcomplete Approach}} to {{Fitting Drift-Diffusion Decision Models}} to {{Trial-By-Trial Data}}},
  author = {Feltgen, Q. and Daunizeau, J.},
