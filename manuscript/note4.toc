\contentsline {paragraph}{Accuracy rises with coherence and with duration (R1, R2).}{4}{section*.2}%
\contentsline {paragraph}{The duration benefit is confined to intermediate coherence (R3).}{4}{section*.3}%
\contentsline {paragraph}{Response time falls with coherence and with duration (R4, R5).}{4}{section*.4}%
\contentsline {paragraph}{The coherence effect on response time is larger after a short stimulus (R6).}{4}{section*.5}%
\contentsline {subsection}{\numberline {2.2}During the delay}{4}{subsection.2.2}%
\contentsline {paragraph}{The duration effects in the onset-locked window separate the two models (R11, R14).}{5}{section*.6}%
\contentsline {paragraph}{The rate rises through the onset-locked window, faster at higher coherence (R12, R13, R15).}{5}{section*.7}%
\contentsline {paragraph}{The offset-locked rate rises with the maintained level (R16, R17).}{5}{section*.8}%
\contentsline {paragraph}{The rate ramps if and only if there is temporal preparation, and the ramp decelerates (R18).}{5}{section*.9}%
\contentsline {paragraph}{A model without preparation cannot produce the offset-locked ramp (R18, R21).}{6}{section*.10}%
\contentsline {paragraph}{Cells with a higher rate must ramp more slowly (R20, R27).}{6}{section*.11}%
\contentsline {paragraph}{Saturation bounds the coherence effect, and reverses the expected interaction (R19).}{6}{section*.12}%
