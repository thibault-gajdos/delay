@article{korolczukDontStopMe2022,
  title = {Don't {{Stop Me Now}}: {{Neural Underpinnings}} of {{Increased Impulsivity}} to {{Temporally Predictable Events}}},
  shorttitle = {Don't {{Stop Me Now}}},
  author = {Korolczuk, Inga and Burle, Boris and Coull, Jennifer T. and Ogi{\'n}ska, Halszka and Ociepka, Micha{\l} and Senderecka, Magdalena and {\'S}migasiewicz, Kamila},
