@techreport{leeOnlineMetacognitiveControl2023,
  type = {Preprint},
  title = {The Online Metacognitive Control of Decisions},
  author = {Lee, D. and B{\'e}non, J. and Hopper, W. and Verdeil, M. and Pessiglione, M. and Vinckier, F. and Bouret, S. and Rouault, M. and Lebouc, R. and Pezzulo, G. and Schreiweis, C. and Burgui{\`e}re, E. and Daunizeau, J.},
  year = 2023,
