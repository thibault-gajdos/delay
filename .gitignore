# OS / editor
.DS_Store
**/.DS_Store
.#*
*~

# Python
__pycache__/
*.pyc
scripts/.venv/

# regenerable / large / log outputs from the model-calibration pipeline
# (small provenance JSON such as calibb_*.json, ckptq_*.json, calibq_*.json,
# sweep_model*.json, targets_*.json ARE tracked -- they are the calibration
# results the manuscript cites, not scratch. fit_model*.json -- the joint
# EMG+behaviour fit's output -- was removed 2026-08-30, see scripts/README.md)
scripts/results/logs/
scripts/results/*.jsonl
scripts/plots/*.pdf
scripts/__pycache__/

# renv (renv itself manages scripts/R/renv/.gitignore once renv::init() has run;
# this covers the same ground before that file exists)
scripts/R/renv/library/
scripts/R/renv/local/
scripts/R/renv/cellar/
scripts/R/renv/lock/
scripts/R/renv/python/
scripts/R/renv/sandbox/
scripts/R/renv/staging/
