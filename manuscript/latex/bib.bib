@article{lianRelatingSparsePredictive2025,
  title = {Relating Sparse and Predictive Coding to Divisive Normalization},
  author = {Lian, Yanbo and Burkitt, Anthony N.},
  editor = {Gutkin, Boris S.},
  year = 2025,
  month = may,
