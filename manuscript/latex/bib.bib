@article{khoudaryReasoningGoalsRepresentational2025,
  title = {Reasoning {{Goals}} and {{Representational Decisions}} in {{Computational Cognitive Neuroscience}}: {{Lessons From}} the {{Drift Diffusion Model}}},
  shorttitle = {Reasoning {{Goals}} and {{Representational Decisions}} in {{Computational Cognitive Neuroscience}}},
  author = {Khoudary, Ari and Peters, Megan~A.~K. and Bornstein, Aaron~M.},
