@misc{arecharUnderstandingCombatingMisinformation2022,
  title = {Understanding and {{Combating Misinformation Across}} 16 {{Countries}} on {{Six Continents}}},
  author = {Arechar, Antonio Alonso and Allen, Jennifer Nancy Lee and Berinsky, Adam and Cole, Rocky and Epstein, Ziv and Garimella, Kiran and Gully, Andrew and Lu, Jackson G. and Ross, Robert M and Stagnaro, Michael and Zhang, Jerry and Pennycook, Gordon and Rand, David Gertler},
  year = 2022,
