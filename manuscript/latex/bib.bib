  title = {Beta {{Oscillations}} as {{Internal Timers}}: {{Independent Contributions}} of {{Temporal Predictability}} to {{Motor Preparation}}},
  shorttitle = {Beta {{Oscillations}} as {{Internal Timers}}},
  author = {Li, Junhui and Zhai, Mengdie and Liu, Lizi and Qian, Yuchen and Liao, Yu},
  year = 2026,
  month = feb,
  journal = {Psychophysiology},
  volume = {63},
