\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The manuscript's Figure~1, simulated. Mean gated motor-preparatory signal at the calibrated parameters, time-locked to the four trial events, with a one standard deviation band; each trial is censored at its own response. Colour is coherence, line style is stimulus duration; the dotted lines are the internal threshold $\theta $ and the gate $g$. Top: Model~2. Bottom: Model~1, refitted in its own right. The difference is entirely in the second panel, where Model~2 climbs towards the gate through the delay and Model~1 does not. The panels are means: the cartoon's clean separation between conditions survives as an ordering, and the band shows how little of it a single trial sees.}}{29}{figure.caption.69}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:traj}{{1}{29}{The manuscript's Figure~1, simulated. Mean gated motor-preparatory signal at the calibrated parameters, time-locked to the four trial events, with a one standard deviation band; each trial is censored at its own response. Colour is coherence, line style is stimulus duration; the dotted lines are the internal threshold $\theta $ and the gate $g$. Top: Model~2. Bottom: Model~1, refitted in its own right. The difference is entirely in the second panel, where Model~2 climbs towards the gate through the delay and Model~1 does not. The panels are means: the cartoon's clean separation between conditions survives as an ordering, and the band shows how little of it a single trial sees}{figure.caption.69}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One simulated trial, the counterpart of the manuscript's Figure~2B--C. Above, the gated signal with the gate $g$ and the response criterion $g+r$; below, the intervals the detection rules return, after merging at $25$~ms and discarding intervals with too few supra-threshold samples. Orange is a partial activation, red the activation that reaches the criterion and becomes the response.}}{29}{figure.caption.70}\protected@file@percent }
\newlabel{fig:single}{{2}{29}{One simulated trial, the counterpart of the manuscript's Figure~2B--C. Above, the gated signal with the gate $g$ and the response criterion $g+r$; below, the intervals the detection rules return, after merging at $25$~ms and discarding intervals with too few supra-threshold samples. Orange is a partial activation, red the activation that reaches the criterion and becomes the response}{figure.caption.70}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Partial-activation rate, data (thin, pale) against model (thick), at the calibrated parameters with the detection rules applied to the simulated signal. The delay panel shows the main residual: the model spreads the three coherence levels far too widely after a short stimulus, where the data are nearly flat. That is the saturation argument of Section~\ref {sec:pred} made numerical.}}{30}{figure.caption.71}\protected@file@percent }
\newlabel{fig:rates}{{3}{30}{Partial-activation rate, data (thin, pale) against model (thick), at the calibrated parameters with the detection rules applied to the simulated signal. The delay panel shows the main residual: the model spreads the three coherence levels far too widely after a short stimulus, where the data are nearly flat. That is the saturation argument of Section~\ref {sec:pred} made numerical}{figure.caption.71}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The shape prediction, on data alone. Left, the six offset-locked log-rate profiles. Right, the log-rate slope falls as the cell's rate rises, as \MT_extended_eqref:n  {eq:slope} requires, since a higher rate means a smaller distance to the gate. Open symbols are the short duration, filled the long.}}{30}{figure.caption.72}\protected@file@percent }
\MT@newlabel{eq:slope}
\newlabel{fig:shape}{{4}{30}{The shape prediction, on data alone. Left, the six offset-locked log-rate profiles. Right, the log-rate slope falls as the cell's rate rises, as \eqref {eq:slope} requires, since a higher rate means a smaller distance to the gate. Open symbols are the short duration, filled the long}{figure.caption.72}{}}
