@article{dillonUsingDriftDiffusion2024,
  title = {Using {{Drift Diffusion}} and {{RL Models}} to {{Disentangle Effects}} of {{Depression On Decision-Making}} vs. {{Learning}} in the {{Probabilistic Reward Task}}},
  author = {Dillon, Daniel G. and Belleau, Emily L. and Origlio, Julianne and McKee, Madison and Jahan, Aava and Meyer, Ashley and Souther, Min Kang and Brunner, Devon and Kuhn, Manuel and Ang, Yuen Siang and Cusin, Cristina and Fava, Maurizio and Pizzagalli, Diego A.},
  year = 2024,
  month = may,
  journal = {Computational Psychiatry},
  volume = {8},
