# OS / editor
.DS_Store
**/.DS_Store
.#*
*~

# Python
__pycache__/
*.pyc
scripts/.venv/

# regenerable / large / log outputs.  The small JSON in scripts/results/ ARE tracked --
# they are the numbers the manuscript cites, not scratch -- as is ramp_check.jsonl, which
# is small and is the record of the high-precision re-simulation.  The sweep dumps are
# large and regenerable.
scripts/results/logs/
scripts/results/*.jsonl
!scripts/results/ramp_check.jsonl
scripts/plots/*.pdf
scripts/__pycache__/

# renv (renv itself manages scripts/R/renv/.gitignore once renv::init() has run;
# this covers the same ground before that file exists)
scripts/R/renv/library/
scripts/R/renv/local/
scripts/R/renv/cellar/
scripts/R/renv/lock/
scripts/R/renv/python/
scripts/R/renv/sandbox/
scripts/R/renv/staging/
