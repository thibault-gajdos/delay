@article{lehmannKetamineIncreasesFrontoposterior2022,
  title = {Ketamine Increases Fronto-Posterior Functional Connectivity during Meta-Perceptual Confidence Ratings},
  author = {Lehmann, Mirko and Neumann, Claudia and Wasserthal, Sven and Delis, Achilles and Schultz, Johannes and Hurlemann, Ren{\'e} and Ettinger, Ulrich},
  year = 2022,
