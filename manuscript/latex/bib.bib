}

@article{vinckierElevatedEffortCost2022,
  title = {Elevated {{Effort Cost Identified}} by {{Computational Modeling}} as a {{Distinctive Feature Explaining Multiple Behaviors}} in {{Patients With Depression}}},
  author = {Vinckier, Fabien and Jaffre, Claire and Gauthier, Claire and Smajda, Sarah and {Abdel-Ahad}, Pierre and Le Bouc, Rapha{\"e}l and Daunizeau, Jean and Fefeu, Myl{\`e}ne and Borderies, Nicolas and Plaze, Marion and Gaillard, Rapha{\"e}l and Pessiglione, Mathias},
  year = 2022,
