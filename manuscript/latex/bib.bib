@article{degosAnticipationImpulsivityParkinsons2022,
  title = {From Anticipation to Impulsivity in {{Parkinson}}'s Disease},
  author = {Degos, Bertrand and Pouget, Pierre and Missal, Marcus},
  year = 2022,
  month = oct,
  journal = {npj Parkinson's Disease},
  volume = {8},
