@article{shadmehrPrecisVigorNeuroeconomics2021,
  title = {Pr\'ecis of {{{\emph{Vigor}}}}{\emph{: }}{{{\emph{Neuroeconomics}}}}{\emph{ of }}{{{\emph{Movement Control}}}}},
