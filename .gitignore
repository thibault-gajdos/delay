# OS / editor
.DS_Store
**/.DS_Store
.#*
~$*
auto/
**/auto/
*~
Claude outputs/

# Python
__pycache__/
*.pyc
scripts/.venv/

# regenerable / large / log outputs.  The small JSON in scripts/results/ ARE tracked --
# they are the numbers the manuscript cites.  The sweep dumps are large and regenerable.
scripts/results/shards/
scripts/results/*.jsonl
scripts/results/leak/*.jsonl
scripts/results/leak/log_*.txt
scripts/results/leak/.shards

# renv (renv itself manages scripts/R/renv/.gitignore once renv::init() has run;
# this covers the same ground before that file exists)
scripts/R/renv/library/
scripts/R/renv/local/
scripts/R/renv/cellar/
scripts/R/renv/lock/
scripts/R/renv/python/
scripts/R/renv/sandbox/
scripts/R/renv/staging/

# PDF copies of the figures (the manuscript PNGs are in manuscript/latex/figures/)
scripts/plots/

# large binaries removed from history (2026-09-09): the OSF zip is redundant with its
# own unpacked contents under data/86cbw-osfstorage-archive/, the av_epochs_*.npy are
# derived epoch averages nothing here reads, and the .rdata are fits of the removed
# Bayesian pipelines.  Keep them out of git; they live on disk and on the OSF page.
data/86cbw-osfstorage-archive.zip
data/*.rdata
data/86cbw-osfstorage-archive/analysis_MBL/data/av_epochs_*.npy

# local mirror of the pre-purge history
_git_backup_*.git/

# leak-grid dumps (regenerable; leak_summary.json is the citable output)
scripts/results/leak/gx*/
