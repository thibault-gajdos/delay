@article{smithMotorResponseVigour2022,
  title = {Motor Response Vigour and Visual Fixation Patterns Reflect Subjective Valuation during Intertemporal Choice},
  author = {Smith, Elke and Peters, Jan},
  editor = {Blohm, Gunnar},
  year = 2022,
