@article{albantakisChangesMindAttractor2011,
  title = {Changes of {{Mind}} in an {{Attractor Network}} of {{Decision-Making}}},
  author = {Albantakis, Larissa and Deco, Gustavo},
  editor = {Behrens, Tim},
  year = 2011,
  month = jun,
  journal = {PLoS Computational Biology},
  volume = {7},
  number = {6},
  pages = {e1002086},
  issn = {1553-7358},
  doi = {10.1371/journal.pcbi.1002086},
  urldate = {2022-11-19},
  abstract = {Attractor networks successfully account for psychophysical and neurophysiological data in various decision-making tasks. Especially their ability to model persistent activity, a property of many neurons involved in decision-making, distinguishes them from other approaches. Stable decision attractors are, however, counterintuitive to changes of mind. Here we demonstrate that a biophysically-realistic attractor network with spiking neurons, in its itinerant transients towards the choice attractors, can replicate changes of mind observed recently during a two-alternative random-dot motion (RDM) task. Based on the assumption that the brain continues to evaluate available evidence after the initiation of a decision, the network predicts neural activity during changes of mind and accurately simulates reaction times, performance and percentage of changes dependent on difficulty. Moreover, the model suggests a low decision threshold and high incoming activity that drives the brain region involved in the decision-making process into a dynamical regime close to a bifurcation, which up to now lacked evidence for physiological relevance. Thereby, we further affirmed the general conformance of attractor networks with higher level neural processes and offer experimental predictions to distinguish nonlinear attractor from linear diffusion models.},
  langid = {english},
  keywords = {metacognition},
  file = {/Users/thibault/Zotero/storage/ZYWXGPWU/Albantakis et Deco - 2011 - Changes of Mind in an Attractor Network of Decisio.pdf}
}

@article{alempakiReexaminingHowUtility2019,
  title = {Reexamining {{How Utility}} and {{Weighting Functions Get Their Shapes}}: {{A Quasi-Adversarial Collaboration Providing}} a {{New Interpretation}}},
  shorttitle = {Reexamining {{How Utility}} and {{Weighting Functions Get Their Shapes}}},
  author = {Alempaki, Despoina and Canic, Emina and Mullett, Timothy L. and Skylark, William J. and Starmer, Chris and Stewart, Neil and Tufano, Fabio},
  year = 2019,
  month = oct,
  journal = {Management Science},
  volume = {65},
